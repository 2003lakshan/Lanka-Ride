# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/lanka-airport-ride?retryWrites=true&w=majority

# Authentication Secrets
NEXTAUTH_SECRET=generate_a_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Payment Gateways (For future phases)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=

# Realtime WebSocket / Socket.IO Server Configuration
NEXT_PUBLIC_REALTIME_URL=http://192.168.8.100:3001
REALTIME_PORT=3001
INTERNAL_REALTIME_SECRET=generate_a_random_internal_realtime_secret
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.8.100:3000
# REDIS_URL=redis://localhost:6379 # Optional: required only for multi-instance scaling

# Email Provider Configuration (SMTP for Password Reset OTP & Notifications)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.com
SMTP_PASS=your_smtp_password_or_api_key
SMTP_SECURE=false
EMAIL_FROM="Lanka Airport Ride <noreply@lankaairportride.com>"

# Private Identity Document Storage & Retention
# For local development / persistent server:
IDENTITY_DOCUMENTS_DIR="./uploads/identity_documents"
IDENTITY_DOCUMENTS_MAX_SIZE_MB=5
IDENTITY_DOCUMENTS_RETENTION_DAYS=90

# For durable production cloud storage (AWS S3, Cloudflare R2, MinIO):
# When S3_BUCKET_NAME is set, uploads persist to S3 rather than local disk.
# S3_BUCKET_NAME="my-private-identity-bucket"
# S3_REGION="us-east-1"
# S3_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com" # Required for Cloudflare R2 or MinIO; omit for AWS S3
# AWS_ACCESS_KEY_ID="your_aws_or_r2_access_key"
# AWS_SECRET_ACCESS_KEY="your_aws_or_r2_secret_key"

# Scheduled Cron Job Authorization (Vercel Cron & Retention Cleanup)
# CRON_SECRET=generate_a_secure_cron_token_here

NEXT_PUBLIC_REALTIME_PORT=3001
REALTIME_HOST=0.0.0.0
REALTIME_INTERNAL_URL=http://localhost:3001
